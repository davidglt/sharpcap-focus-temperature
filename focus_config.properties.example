; SharpCap focus-temperature local configuration template.
; Copy this file to focus_config.properties and edit it for your equipment.
;
; The selected interval is always calculated as:
; min_position = focus_center - focus_range / 2
; max_position = focus_center + focus_range / 2
;
; focus_range must be a positive even integer.

[main]
; C8 + ASI2600MC Pro + focal reducer f/6.3
focus_center = 18700
focus_range = 3000

[guide]
; Sky-Watcher 50ED + ASI224MC
focus_center = 347000
focus_range = 50000