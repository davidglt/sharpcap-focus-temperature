; Local per-tube focus configuration.
; This file is a tracked example. Copy it to focus_config.properties and adapt
; the values after measuring autofocus results for your own observatory:
;
;   Copy-Item focus_config.properties.example focus_config.properties
;
; focus_config.properties is intentionally ignored by Git.

; focus_center is the ZWO EAF position in steps at temperature_center.
; focus_range is the full accepted focuser interval width in EAF steps. It must
; be a positive even integer, so the accepted interval remains centred exactly
; on focus_center:
;
;   minimum position = focus_center - focus_range / 2
;   maximum position = focus_center + focus_range / 2
;
; temperature_center is the focuser temperature in degrees Celsius at which
; focus_center is valid. Use two decimal places. It is the reference
; temperature used by synthetic focus-temperature data generation.
;
; estimated_tcf is the per-tube estimated temperature compensation factor in
; EAF steps per degree Celsius. Synthetic generation uses it when --tcf is not
; supplied. A command-line --tcf value has higher priority for that execution.
;
; The expected TCF is normally negative for these configurations: the required
; focuser position moves to fewer EAF steps as temperature rises. Recalibrate
; focus_center, temperature_center and estimated_tcf whenever the optical
; train, camera, filter, reducer, spacing, or focuser mechanics change.

[main]
; Optical train: Celestron C8 + f/6.3 focal reducer + ZWO EFW7
; + ZWO ASI2600MC Pro.
; Focuser: ZWO EAF.
focus_center = 18706
focus_range = 3000
temperature_center = 19.43
estimated_tcf = -60.00

[guide]
; Optical train: Sky-Watcher 50ED + UV/IR-cut filter + ZWO ASI224MC.
; Focuser: ZWO EAF.
focus_center = 391982
focus_range = 50000
temperature_center = 18.70
estimated_tcf = -977.18