; temperature_center is the focuser temperature in degrees Celsius at which
; focus_center is valid. Use exactly two decimal places. It is used as the
; reference point when generating synthetic focus-temperature data.

[main]
; C8 + ASI2600MC Pro + focal reducer f/6.3
focus_center = 18700
focus_range = 3000
temperature_center = 15.00

[guide]
; Sky-Watcher 50ED + ASI224MC
focus_center = 347000
focus_range = 50000
temperature_center = 15.00